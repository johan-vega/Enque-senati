rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validTask(d) {
      return d.keys().hasAll(['title','description','categoryId','dueAt','priority','completed','reminder','createdAt','updatedAt'])
        && d.keys().hasOnly(['title','description','categoryId','dueAt','priority','completed','reminder','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.title.matches('.*[^ ].*')
        && d.description is string && d.description.size() <= 2000
        && (d.categoryId == null || (d.categoryId is string && d.categoryId.size() <= 100))
        && (d.dueAt == null || d.dueAt is timestamp)
        && d.priority is int && d.priority >= 0 && d.priority <= 2
        && d.completed is bool && d.reminder is bool
        && (!d.reminder || d.dueAt is timestamp)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /tasks/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && validTask(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if owner(uid) && validTask(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
      match /categories/{id} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['name','archived','updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40 && request.resource.data.name.matches('.*[^ ].*')
          && request.resource.data.archived is bool && request.resource.data.updatedAt == request.time;
        // Archival prevents destructive orphaning, including concurrent edits.
        allow delete: if false;
      }
      match /preferences/interface {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['dark','accent','notifications'])
          && request.resource.data.dark is bool && request.resource.data.notifications is bool
          && request.resource.data.accent is int && request.resource.data.accent >= 0 && request.resource.data.accent <= 2;
        allow delete: if owner(uid);
      }
    }
  }
}
